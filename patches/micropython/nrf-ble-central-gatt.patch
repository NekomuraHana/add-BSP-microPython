+// Write a GATT attribute by handle (including a known CCCD handle).
+static mp_obj_t peripheral_write_handle(size_t n_args, const mp_obj_t *args) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(args[0]);
+    if (self->conn_handle == 0xFFFF) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Not connected"));
+    }
+    mp_buffer_info_t buf;
+    mp_get_buffer_raise(args[2], &buf, MP_BUFFER_READ);
+    if (buf.len > 20) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Legacy ATT write limited to 20 bytes"));
+    }
+    ble_drv_attr_c_write(self->conn_handle, mp_obj_get_int(args[1]),
+                         buf.len, buf.buf, n_args == 4 ? mp_obj_is_true(args[3]) : true);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(ubluepy_peripheral_write_handle_obj, 3, 4, peripheral_write_handle);
