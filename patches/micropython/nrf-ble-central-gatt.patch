+static MP_DEFINE_CONST_FUN_OBJ_KW(ubluepy_peripheral_connect_obj, 2, peripheral_connect);
+
+// GATT Client: retain the result on the Peripheral object so GC can trace it.
+static void peripheral_read_complete(mp_obj_t self_in, uint16_t length, uint8_t *data) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(self_in);
+    self->read_result = mp_obj_new_bytes(data, length);
+}
+
+// readCharacteristic(value_handle) -> bytes
+static mp_obj_t peripheral_read_char(mp_obj_t self_in, mp_obj_t handle_in) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(self_in);
+    if (self->conn_handle == 0xFFFF) {
+        mp_raise_OSError(MP_ENOTCONN);
+    }
+    self->read_result = mp_const_none;
+    ble_drv_attr_c_read(self->conn_handle, mp_obj_get_int(handle_in),
+                        self_in, peripheral_read_complete);
+    return self->read_result;
+}
+static MP_DEFINE_CONST_FUN_OBJ_2(ubluepy_peripheral_read_char_obj, peripheral_read_char);
+
+// writeCharacteristic(value_handle, data, [with_response=True])
+// The same method can write to a CCCD handle to enable notifications.
+static mp_obj_t peripheral_write_char(size_t n_args, const mp_obj_t *args) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(args[0]);
+    if (self->conn_handle == 0xFFFF) {
+        mp_raise_OSError(MP_ENOTCONN);
+    }
+    mp_buffer_info_t buf;
+    mp_get_buffer_raise(args[2], &buf, MP_BUFFER_READ);
+    bool with_response = n_args == 4 ? mp_obj_is_true(args[3]) : true;
+    ble_drv_attr_c_write(self->conn_handle, mp_obj_get_int(args[1]),
+                         buf.len, buf.buf, with_response);
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(ubluepy_peripheral_write_char_obj, 3, 4, peripheral_write_char);
+
+#endif
 
