-static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(ubluepy_peripheral_write_handle_obj, 3, 4, peripheral_write_handle);
+static MP_DEFINE_CONST_FUN_OBJ_VAR_BETWEEN(ubluepy_peripheral_write_handle_obj, 3, 4, peripheral_write_handle);
+
+// Read arbitrary ATT attribute (service / characteristic declarations included).
+static void raw_read_completed(mp_obj_t observer, uint16_t len, uint8_t *data) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(observer);
+    self->raw_read_result = mp_obj_new_bytes(data, len);
+}
+
+static mp_obj_t peripheral_read_handle(mp_obj_t self_in, mp_obj_t handle_in) {
+    ubluepy_peripheral_obj_t *self = MP_OBJ_TO_PTR(self_in);
+    if (self->conn_handle == 0xFFFF) {
+        mp_raise_ValueError(MP_ERROR_TEXT("Not connected"));
+    }
+    self->raw_read_result = mp_const_none;
+    ble_drv_attr_c_read(self->conn_handle, mp_obj_get_int(handle_in),
+                        self_in, raw_read_completed);
+    return self->raw_read_result;
+}
+static MP_DEFINE_CONST_FUN_OBJ_2(ubluepy_peripheral_read_handle_obj, peripheral_read_handle);
 
 
