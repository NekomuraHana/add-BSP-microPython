+// At the boot.py boundary, release UART0 even if Python forgot deinit().
+// A TX-in-progress wait is bounded so a broken peripheral cannot hang boot.
+void uart_boot_script_release(uint32_t timeout_ms) {
+    machine_uart_obj_t *self = &machine_uart_obj[0];
+    if (!self->initialized) {
+        return;
+    }
+    uint32_t started = mp_hal_ticks_ms();
+    while (nrfx_uart_tx_in_progress(self->p_uart) &&
+           (uint32_t)(mp_hal_ticks_ms() - started) < timeout_ms) {
+        mp_event_wait_ms(1);
+    }
+    nrfx_uart_uninit(self->p_uart);
+    self->initialized = false;
+    self->attached_to_repl = false;
+}
+
 void uart_attach_to_repl(machine_uart_obj_t *self, bool attached) {
     self->attached_to_repl = attached;
 }
