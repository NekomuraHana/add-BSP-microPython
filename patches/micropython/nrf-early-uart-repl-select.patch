diff --git a/ports/nrf/main.c b/ports/nrf/main.c
--- a/ports/nrf/main.c
+++ b/ports/nrf/main.c
@@ -113,9 +113,22 @@
     // bootloader should be entered instead of the main application.
     MICROPY_BOARD_STARTUP();
 
-    MICROPY_BOARD_EARLY_INIT();
-
-soft_reset:
+    MICROPY_BOARD_EARLY_INIT();
+
+    // Latch an optional board's REPL selector immediately on hardware reset.
+    // It must not be sampled later during filesystem/Python startup.
+    #if defined(MICROPY_HW_UART_REPL_SELECT_PIN)
+    NRF_P0->PIN_CNF[MICROPY_HW_UART_REPL_SELECT_PIN] =
+        (GPIO_PIN_CNF_DIR_Input << GPIO_PIN_CNF_DIR_Pos) |
+        (GPIO_PIN_CNF_INPUT_Connect << GPIO_PIN_CNF_INPUT_Pos) |
+        (GPIO_PIN_CNF_PULL_Pullup << GPIO_PIN_CNF_PULL_Pos);
+    for (volatile unsigned int settle = 0; settle < 1000; ++settle) {
+    }
+    const bool uart_repl_selected =
+        (NRF_P0->IN & (1UL << MICROPY_HW_UART_REPL_SELECT_PIN)) == 0;
+    #endif
+
+soft_reset:
 
     #if MICROPY_PY_TIME_TICKS
     rtc1_init_time_ticks();
@@ -162,8 +175,12 @@
     uart_init0();
     #endif
 
-    #if MICROPY_HW_ENABLE_UART_REPL
-    {
+    #if MICROPY_HW_ENABLE_UART_REPL
+    #if defined(MICROPY_HW_UART_REPL_SELECT_PIN)
+    if (uart_repl_selected) {
+    #else
+    {
+    #endif
         mp_obj_t args[2] = {
             MP_OBJ_NEW_SMALL_INT(MICROPY_HW_UART_REPL),
             MP_OBJ_NEW_SMALL_INT(MICROPY_HW_UART_REPL_BAUD),
@@ -254,7 +271,12 @@
     #endif
 
     #if MICROPY_VFS || MICROPY_MBFS || MICROPY_MODULE_FROZEN
-    if (pyexec_mode_kind == PYEXEC_MODE_FRIENDLY_REPL && ret_code != 0) {
+    // Hold off main.py while UART REPL is selected.
+    #if defined(MICROPY_HW_UART_REPL_SELECT_PIN)
+    if (!uart_repl_selected && pyexec_mode_kind == PYEXEC_MODE_FRIENDLY_REPL && ret_code != 0) {
+    #else
+    if (pyexec_mode_kind == PYEXEC_MODE_FRIENDLY_REPL && ret_code != 0) {
+    #endif
         pyexec_file_if_exists("main.py");
     }
     #endif
