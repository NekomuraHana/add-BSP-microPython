+// Report shared-resource conflicts rather than transferring with a stale driver.
+static void spi_raise_nrfx_error(nrfx_err_t err) {
+    if (err == NRFX_ERROR_BUSY || err == NRFX_ERROR_INVALID_STATE) {
+        mp_raise_OSError(MP_EBUSY);
+    }
+    #if NRFX_API_VER_AT_LEAST(3, 2, 0)
+    if (err == NRFX_ERROR_ALREADY) {
