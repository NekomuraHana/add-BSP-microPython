         .p_tx_buffer = src,
         .tx_length = len,
@@ -159,7 +201,25 @@
         .rx_length = len
     };
 
+    // Use the interrupt-driven driver path: the blocking nrfx SPI path
+    // otherwise spins forever if READY/END never arrives.
+    self->transfer_done = false;
+    nrfx_err_t err = nrfx_spi_xfer(self->p_spi, &xfer_desc, 0);
+    if (err != NRFX_SUCCESS) {
+        spi_raise_nrfx_error(err);
+    }
+
+    // Conservative bound for 125 kHz transfers, including IRQ overhead.
+    mp_uint_t start = mp_hal_ticks_ms();
+    uint32_t timeout_ms = 1000 + (uint32_t)(len / 8);
+    while (!self->transfer_done) {
+        if ((mp_uint_t)(mp_hal_ticks_ms() - start) >= timeout_ms) {
+            // Release only this SPI instance; do not disturb a TWI owner.
+            nrfx_spi_uninit(self->p_spi);
+            mp_raise_OSError(MP_ETIMEDOUT);
+        }
+        mp_event_wait_ms(1);
+    }
-    nrfx_spi_xfer(self->p_spi, &xfer_desc, 0);
 }
 
