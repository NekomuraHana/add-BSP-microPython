+    #endif
+    if (err == NRFX_ERROR_INVALID_PARAM) {
+        mp_raise_OSError(MP_EINVAL);
+    }
+    mp_raise_OSError(MP_EIO);
+}
+
+static void spi_event_handler(nrfx_spi_evt_t const *event, void *context) {
+    (void)event;
+    machine_hard_spi_obj_t *self = context;
+    self->transfer_done = true;
+}
+
+void spi_transfer(machine_hard_spi_obj_t *self, size_t len, const void *src, void *dest) {
+    if (!nrfx_spi_init_check(self->p_spi)) {
